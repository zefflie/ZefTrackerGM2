;;
;;  FluffTracker Assembler Module
;;  

; Регистр букв игнорируется (кроме строковых литералов)
; - числовые литералы - 16-ричные числа. Чтобы задать 10-ричное, необходим суффикс `d`
; - строковые литералы - текст заключенный в двойные кавычки
; Громкость всегда задается значением от 0 (0%) до 255 (100%)
; Запрещается создавать нулевые индексы - они работают как пустота (void) или же нуль-объект `null`. Но использовать можно для переправки вникуда
; Все индексы нумеруются от 0 до 255



;;  Секция метаданных. Все метки сохранятся ввиде таблицы имя-значение.
SECTION .meta
    title: "Test Module"
    author: "Zefflie"



;;  Секция информации о модуле. Считывается первой. Здесь задаются параметры модуля
SECTION .module
    speed 6d   ; Скорость (тиков на строку)
    tempo 100d ; BPM (ударов в минуту)
    rows  16d  ; Строк на один фрейм
    channels 4 ; Каналов на трек



;;  Секция с порядком паттернов
SECTION .order
    ; df - define frame. Создает фрейм с назначением паттернов каналам
    ; Число запускает паттерн с соответствующим номером на канале по номеру операнда +1 (чтобы не трогать главный канал)
    ; Точки - продолжить проигрывание заданного паттерна (и начать его заново при завершении)
    ; Дефисы - остановить проигрывание заданного паттерна
    df 01 02 03
    df .. .. ..
    df .. .. ..
    df .. .. ..



SECTION .channels
; Структурная метка. `<тип структуры>.<номер структуры>:`
channel.01: ; Мастер-канал. Является выводом звука на устройство воспроизведения/записи
    volume B0 ; Задает громкость ранее объявленной структуре, что это поддерживает. (для канала)

channel.02: ; Лид-канал
    volume F0
    link   01 ; Направляет вывод в указанный канал 

channel.03: ; Басс-канал
    volume B0
    link   01

channel.04: ; Драм-канал
    volume B0
    link   01



;;  Секция инструментов
SECTION .instruments

instrument.01:
    ; Задать генератор волны
    ; В предопределенных `std_*` макросах можно выбрать нужную функцию
    wave   STD_WAVE_PULSE
    duty   20 ; Задать продолжительность пульса. 80 = обычный квадрат (0..FF = 0%..100%)
    volume B0 ; (для генератора)

instrument.02:     
    attack  32 ; Время атаки инструмента (в тиках)
    release 32 ; Время затихания инструмента (в тиках)
    wave    STD_SAW ; Пульс-генератор
    volume  B0
    wave    STD_SAW ; Можно задать несколько генераторов на один инструмент
    pitch   -12d    ; Задать смещение в полутонах
    volume  80

instrument.03:     
    release 12
    wave STD_NOISE_LFSR ; Генератор LFSR шума
    volume B0



;;  Секция паттернов
SECTION .patterns
pattern.01:   ; Особая метка на паттерн. После точки указывается номер паттерна.
    step 2    ; Директива "step" - выравнивает следующие команды на установленный шаг в строках
    B-4 01 70 ; Команда ноты (изначально - note <нота> <инструмент> <громкость>), но для сокращения мнемокод note опущен
    C#5 .. ..
    D-5 .. ..
    F#5 .. ..
    B-5 .. 60
    C#6 .. ..
    D-6 .. ..
    F#6 .. ..

pattern.02:
    B-2 02 70
    skip 13   ; Пропуск строк
    --- .. ..
    ; Пустые строки просто игнорируются, это ассемблер а не типичный модуль трекера!
    B-2 .. ..
    skip 13
    --- .. ..

    G-3 .. ..
    skip 13
    --- .. ..

    A-3 .. ..
    skip 13
    --- .. ..

; Внезапно, макросы препроцессора для магических нот
%define DRUM_TOM   B-4
%define DRUM_SNARE B-5
%define DRUM_HFHAT D-6
%define DRUM_CLHAT D-7

pattern.03:
    DRUM_TOM .. 60
    DRUM_CLHAT .. 30
    DRUM_CLHAT .. 40
    ... .. ..
    DRUM_CLHAT .. 40
    ... .. ..
    DRUM_CLHAT .. 40
    ... .. ..
    DRUM_HFHAT .. 40
    ... .. ..
    ... .. ..
    ... .. ..
    DRUM_CLHAT .. 40
    ... .. ..
    DRUM_CLHAT .. 40
    ... .. ..

    DRUM_TOM .. 60
    ... .. ..
    DRUM_CLHAT .. 40
    ... .. ..
    DRUM_CLHAT .. 40
    ... .. ..
    DRUM_HFHAT .. 40
    ... .. ..
    ... .. ..
    ... .. ..
    DRUM_CLHAT .. 20
    DRUM_CLHAT .. 30
    DRUM_HFHAT .. 40
    ... .. ..
    ... .. ..
    ... .. ..

    DRUM_TOM .. 60
    ... .. ..
    DRUM_CLHAT .. 40
    ... .. ..
    DRUM_CLHAT .. 40
    ... .. ..
    DRUM_CLHAT .. 40
    ... .. ..
    DRUM_HFHAT .. 40
    ... .. ..
    ... .. ..
    ... .. ..
    DRUM_CLHAT .. 40
    ... .. ..
    ... .. ..
    ... .. ..

    DRUM_SNARE .. 60
    ... .. ..
    DRUM_CLHAT .. 40
    ... .. ..
    DRUM_CLHAT .. 40
    ... .. ..
    DRUM_SNARE .. 40
    ... .. ..
    ... .. ..
    ... .. ..
    DRUM_CLHAT .. 20
    DRUM_CLHAT .. 30
    DRUM_SNARE .. 30
    ... .. ..
    ... .. ..
    ... .. ..
    